config_version=5

[application]
config/name="Combat presentation comparison - Godot"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="g"

[display]
window/size/viewport_width=1000
window/size/viewport_height=620
window/size/window_width_override=1000
window/size/window_height_override=620
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.952941, 0.917647, 0.843137, 1)
